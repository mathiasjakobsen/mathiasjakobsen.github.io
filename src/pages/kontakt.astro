---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Kontakt - Mathias Jakobsen">
  <Header />
  <main>
    <section class="pt-24 md:pt-32 pb-16 md:pb-24">
      <div class="max-w-4xl px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-light text-frost-dark leading-tight mb-6">
          Let's Talk
        </h1>
        <p class="text-lg md:text-xl text-frost-accent leading-relaxed max-w-3xl mb-12">
          Interested in working together? Drop me a line and I'll get back to you within 24 hours.
        </p>

        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h2 class="text-2xl font-light text-frost-dark mb-6">Contact Information</h2>
            <div class="space-y-4">
              <div>
                <h3 class="text-sm font-medium text-frost-accent mb-1">Email</h3>
                <a href="mailto:hello@mathiasjakobsen.com" class="text-lg text-frost-dark hover:text-frost-accent transition-colors">
                  hello@mathiasjakobsen.com
                </a>
              </div>
              <div>
                <h3 class="text-sm font-medium text-frost-accent mb-1">GitHub</h3>
                <a href="https://github.com/mathiasjakobsen" target="_blank" rel="noopener noreferrer" class="text-lg text-frost-dark hover:text-frost-accent transition-colors">
                  @mathiasjakobsen
                </a>
              </div>
              <div>
                <h3 class="text-sm font-medium text-frost-accent mb-1">LinkedIn</h3>
                <a href="https://linkedin.com/in/mathiasjakobsen" target="_blank" rel="noopener noreferrer" class="text-lg text-frost-dark hover:text-frost-accent transition-colors">
                  Mathias Jakobsen
                </a>
              </div>
            </div>
          </div>

          <div>
            <h2 class="text-2xl font-light text-frost-dark mb-6">Quick Links</h2>
            <ul class="space-y-3">
              <li>
                <a href="/fractional-cto" class="text-lg text-frost-dark hover:text-frost-accent transition-colors">
                  Fractional CTO Services
                </a>
              </li>
              <li>
                <a href="/softwareudvikler" class="text-lg text-frost-dark hover:text-frost-accent transition-colors">
                  Software Development
                </a>
              </li>
              <li>
                <a href="/udtalelser" class="text-lg text-frost-dark hover:text-frost-accent transition-colors">
                  Testimonials
                </a>
              </li>
              <li>
                <a href="/cases" class="text-lg text-frost-dark hover:text-frost-accent transition-colors">
                  Case Studies
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
