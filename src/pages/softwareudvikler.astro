---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Softwareudvikler - Mathias Jakobsen">
  <Header />
  <main>
    <section class="pt-24 md:pt-32 pb-16 md:pb-24">
      <div class="max-w-4xl px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-light text-frost-dark dark:text-gray-100 leading-tight mb-6">
          Erfaren Softwareudvikler
        </h1>
        <p class="text-lg md:text-xl text-frost-accent dark:text-gray-300 leading-relaxed max-w-3xl">
          Med over 15 års erfaring udvikler jeg skalerbare softwareløsninger der driver forretningsresultater.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
