---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Fractional CTO - Mathias Jakobsen">
  <Header />
  <main>
    <section class="pt-24 md:pt-32 pb-16 md:pb-24">
      <div class="max-w-4xl px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-light text-frost-dark leading-tight mb-6">
          Fractional CTO Services
        </h1>
        <p class="text-lg md:text-xl text-frost-accent leading-relaxed max-w-3xl mb-8">
          Get experienced technical leadership on a flexible basis. I help startups and growing companies navigate complex technical decisions without the cost of a full-time CTO.
        </p>

        <div class="space-y-12 mt-12">
          <div>
            <h2 class="text-2xl md:text-3xl font-light text-frost-dark mb-4">
              What is a Fractional CTO?
            </h2>
            <p class="text-lg text-frost-accent leading-relaxed">
              A fractional CTO provides strategic technical leadership on a part-time or contract basis. You get all the benefits of a seasoned technology executive - strategic vision, architectural guidance, team leadership - tailored to your specific needs and budget.
            </p>
          </div>

          <div>
            <h2 class="text-2xl md:text-3xl font-light text-frost-dark mb-4">
              Services I Provide
            </h2>
            <ul class="space-y-4 text-lg text-frost-accent">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-frost-dark mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Technology strategy and roadmap development</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-frost-dark mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>System architecture design and review</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-frost-dark mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Engineering team building and mentorship</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-frost-dark mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Technical due diligence for investors</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-frost-dark mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Vendor evaluation and technology stack selection</span>
              </li>
            </ul>
          </div>

          <div>
            <h2 class="text-2xl md:text-3xl font-light text-frost-dark mb-4">
              Who Is This For?
            </h2>
            <p class="text-lg text-frost-accent leading-relaxed mb-4">
              Fractional CTO services are ideal for:
            </p>
            <ul class="space-y-2 text-lg text-frost-accent">
              <li>" Early-stage startups building their first product</li>
              <li>" Companies scaling from 5 to 50 engineers</li>
              <li>" Non-technical founders who need technical guidance</li>
              <li>" Companies navigating a major technical transition</li>
            </ul>
          </div>

          <div class="pt-8">
            <a
              href="/kontakt"
              class="inline-block px-8 py-3 bg-frost-dark text-white rounded-frost hover:bg-frost-accent transition-all duration-250 hover:scale-105 hover:shadow-lg"
            >
              Schedule a Consultation
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
