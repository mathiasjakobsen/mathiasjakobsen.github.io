---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <Header />
  <main id="main-content">
    <section class="pt-24 md:pt-32 pb-16 md:pb-24">
      <div class="max-w-4xl px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24">
        <article class="prose prose-lg max-w-none text-frost-accent dark:text-gray-300">
          <slot />
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
  .prose h1 {
    font-size: 2.5rem;
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 2rem;
    color: hsl(0, 0%, 12%);
  }

  .prose h2 {
    font-size: 1.875rem;
    font-weight: 300;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: hsl(0, 0%, 12%);
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 300;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: hsl(0, 0%, 12%);
  }

  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }

  .prose strong {
    font-weight: 400;
  }

  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose a {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
    transition: color 0.15s;
  }

  .dark .prose h1,
  .dark .prose h2,
  .dark .prose h3 {
    color: rgb(243, 244, 246);
  }

  .dark .prose a {
    color: rgb(209, 213, 219);
  }

  .dark .prose a:hover {
    color: rgb(243, 244, 246);
  }

  @media (min-width: 768px) {
    .prose h1 {
      font-size: 3.75rem;
    }

    .prose h2 {
      font-size: 2.25rem;
    }

    .prose h3 {
      font-size: 1.875rem;
    }
  }
</style>
