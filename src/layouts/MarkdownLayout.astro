---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <Header />
  <main id="main-content">
    <section class="pt-24 md:pt-32 pb-16 md:pb-24">
      <div class="max-w-4xl px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24">
        <article class="prose prose-lg prose-frost dark:prose-invert max-w-none">
          <slot />
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>

  .prose h1 {
    font-size: 2.5rem;
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 2rem;
  }

  .prose h2 {
    font-size: 1.875rem;
    font-weight: 300;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 300;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }

  .prose strong {
    font-weight: 400;
  }

  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    .prose h1 {
      font-size: 3.75rem;
    }

    .prose h2 {
      font-size: 2.25rem;
    }

    .prose h3 {
      font-size: 1.875rem;
    }
  }
</style>
