---
const scenarios = [
  {
    industry: 'Vi et et bootstrapped startup, og hver en krone betyder alverden i vores opstart',
    challenge: 'I har en pisse god idé, men I tør ikke købe ind på dyre konsulenthuse der lover guld og grønne skove (og lange kontrakter). Det er altafgørende at I ved hvad I får, hvad prisen er alt inklusiv og at intet falder mellem to stole.',
    solution: 'Jeg hjælper jer ud over stepperne med en MVP, bygget med en moderne men moden tech-stack som ikke er outdated i næste uge. Det sikre I kan bevæge jer hurtigt, bygge ovenpå og vigtigst af alt; undgå "vi var nød til at få lavet det hele om" mareridtet.',
    tags: ['Softwareudvikling', 'MVP', 'DevOps'],
  },
  {
    industry: 'Vi er et early-stage startup, som mangler en one-man-army der kan levere på tech i stedet for at kræve flere resourcer',
    challenge: 'I har en verdensklasse idé, forretningsplan og team klar til at rykke - men det er for tidligt at få en teknisk co-founder og for dyrt at ansætte en kapabel CTO.',
    solution: 'Jeg hjælper jer ud over stepperne med en MVP, bygget med en moderne men moden tech-stack som ikke er outdated i næste uge. Det sikre I kan bevæge jer hurtigt, bygge ovenpå og vigtigst af alt; undgå "vi var nød til at få lavet det hele om" smøren til jeres investorer.',
    tags: ['MVP', 'DevOps'],
  },
  {
    industry: 'Enterprise Teams',
    challenge: 'Modernisering af legacy-systemer uden at forstyrre forretningen',
    solution: 'Jeg planlægger trinvise migrationsstrategier, introducerer moderne værktøjer og opkvalificerer dit udviklingsteam.',
    tags: ['Legacy Migration', 'Arkitektur', 'Mentorskab'],
  },




  {
    industry: 'Vi har SMV',
    challenge: 'Skalering af infrastruktur samtidig med at velocity fastholdes',
    solution: 'Jeg designer systemer der håndterer 10x vækst, implementerer overvågning og etablerer engineering best practices.',
    tags: ['Skalerbarhed', 'DevOps', 'Team Processer'],
  },
  {
    industry: 'Enterprise Teams',
    challenge: 'Modernisering af legacy-systemer uden at forstyrre forretningen',
    solution: 'Jeg planlægger trinvise migrationsstrategier, introducerer moderne værktøjer og opkvalificerer dit udviklingsteam.',
    tags: ['Legacy Migration', 'Arkitektur', 'Mentorskab'],
  },
  {
    industry: 'Produktvirksomheder',
    challenge: 'Balance mellem feature velocity og teknisk ekspertise',
    solution: 'Jeg etablerer effektive udviklingsworkflows, automatiseret testning og klare tekniske roadmaps.',
    tags: ['Proces Optimering', 'CI/CD', 'Kvalitet'],
  },
  {
    industry: 'Etablerede virksomhed',
    challenge: 'Udviklerne forstår ikke kravene, men løser (hovedløst) opgaverne som jeres frusterede projektledere ikke kan ',
    solution: 'Jeg er bindeledet imellem tech og forretning, og hjælper jer med at få softwareudviklerne til at forstå jeres kerneforretning, fremfor at parere ordre så I får bugt med frustrationer, bedre systemer og gladere kunder.',
    tags: ['Proces Optimering', 'CI/CD', 'Kvalitet'],
  },
];
---

<section class="py-16 md:py-24">
  <div class="max-w-4xl px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24">
    <div class="mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-frost-dark dark:text-gray-100 mb-4">
      </h2>
      <p class="text-lg md:text-xl text-frost-accent dark:text-gray-300 max-w-3xl">
        Kan du genkende din udfordring her? Så kan jeg garanteret hjælpe.
      </p>
    </div>

    <div class="grid gap-6 md:gap-8">
      {scenarios.map((scenario) => (
        <div class="bg-white dark:bg-gray-800 rounded-frost p-6 md:p-8 hover:shadow-lg transition-all duration-250 border border-gray-200 dark:border-gray-700">
          <h3 class="text-2xl font-light text-frost-dark dark:text-gray-100 mb-3">
            {scenario.industry}
          </h3>
          <div class="space-y-4 mb-6">
            <div>
              <p class="text-sm font-medium text-frost-accent dark:text-gray-400 mb-1">Udfordring:</p>
              <p class="text-frost-dark dark:text-gray-200">{scenario.challenge}</p>
            </div>
            <div>
              <p class="text-sm font-medium text-frost-accent dark:text-gray-400 mb-1">Løsning:</p>
              <p class="text-frost-dark dark:text-gray-200">{scenario.solution}</p>
            </div>
          </div>
          <div class="flex flex-wrap gap-2">
            {scenario.tags.map((tag) => (
              <span class="px-3 py-1 bg-frost-light dark:bg-gray-700 text-frost-accent dark:text-gray-300 text-sm rounded-full border border-gray-200 dark:border-gray-600">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8 md:mt-12 text-lg text-frost-accent dark:text-gray-300">
      Nysgerrig på værktøjskassen? <a href="/tech-stack" class="underline underline-offset-2 decoration-1 hover:text-frost-dark dark:hover:text-gray-100 transition-colors">Se min tech stack</a>
    </p>
  </div>
</section>
