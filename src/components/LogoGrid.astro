---
// Add your client logos to public/logos/ directory as SVG files
// The logos will automatically invert colors between light/dark mode
const logos = [
  { name: 'Omsorg A/S', file: '/logos/Omsorg.svg' },
  { name: 'VoiceArchive', file: '/logos/VoiceArchive.svg' },
  { name: 'Arnsbo Group', file: '/logos/AG.svg' },
  { name: 'Spotify', file: '/logos/Spotify.svg' },
  { name: 'M2 Film', file: '/logos/M2.svg' },
  { name: 'Fliva', file: '/logos/Fliva.svg' },
  { name: 'ADRENALINE Studios', file: '/logos/ADRENALINE.svg' },
  { name: '3P Learning', file: '/logos/3P.svg' },
];
---

<section id="logo-grid" class="py-16 md:py-24 bg-white dark:bg-gray-800 border-t border-b border-gray-200 dark:border-gray-700">
  <div class="max-w-4xl px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24">
    <div class="mb-12 md:mb-16 space-y-4">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-frost-dark dark:text-gray-100 mb-4">
        Vil du i godt selskab?
      </h2>
      <p class="text-lg md:text-xl text-frost-accent dark:text-gray-300 max-w-3xl">
        Jeg har som softwareudvikler, CTO, arbejdsgiver, direktør, advisor og selvstændig hjulpet både etablerede virksomheder, SMVer og startups med softwareudvikling, projekter, strategi og ledelse.
      </p>
      <p class="text-lg md:text-xl text-frost-accent dark:text-gray-300 max-w-3xl">
        Spørg dem bare - og hils fra Math-IT-as 👋🏻
      <p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6 md:gap-8">
      {logos.map((logo) => (
        <div class="flex items-center justify-center p-6 bg-frost-light dark:bg-gray-900 rounded-frost border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-all duration-250">
          <img
            src={logo.file}
            alt={logo.name}
            title={logo.name}
            class="w-full h-auto max-h-12 object-contain opacity-60 dark:opacity-70 hover:opacity-100 dark:hover:opacity-100 transition-opacity duration-250 logo-invert"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Invert logo colors for dark mode - black logos become white */
  .logo-invert {
    filter: brightness(0) saturate(100%);
  }

  :global(.dark) .logo-invert {
    filter: brightness(0) saturate(100%) invert(1);
  }
</style>
