---
import OfficeStatus from './OfficeStatus.astro';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '#services', label: 'Hvad jeg laver' },
  { href: '#testimonials', label: 'Udtalelser' },
  { href: '#contact', label: 'Kontakt' },
];

const socialLinks = [
  {
    href: 'https://github.com/mathiasjakobsen',
    label: 'GitHub',
    external: true,
    ariaLabel: 'GitHub (åbner i nyt vindue)'
  },
  {
    href: 'https://linkedin.com/in/mathiasjakobsen',
    label: 'LinkedIn',
    external: true,
    ariaLabel: 'LinkedIn (åbner i nyt vindue)'
  },
];

const legalLinks = [
  { href: '/ai', label: 'AI-holdning' },
  { href: '/tilgaengelighed', label: 'Tilgængelighed' },
  { href: '/databeskyttelse', label: 'Databeskyttelse' },
  { href: '/vilkaar-og-betingelser', label: 'Vilkår & betingelser' },
];
---

<footer id="contact" class="bg-frost-light dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 py-16 md:py-24">
  <div class="px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24 mr-4 sm:mr-12 lg:mr-24">
    <div class="grid md:grid-cols-3 gap-12 mb-12">
      <!-- About -->
      <div class="space-y-6">
        <h3 class="text-xl font-light mb-4 text-frost-dark dark:text-gray-100">Mathias Lynnerup Jakobsen</h3>
        <p class="text-frost-accent dark:text-gray-300 leading-relaxed">
          CTO & Software Engineer specialiseret i skalerbare systemer og teknisk ledelse.
          Bygger fremtiden, et commit ad gangen.
        </p>
        <address class="text-frost-accent dark:text-gray-300 not-italic">
          <a
            href="https://maps.app.goo.gl/9TWXB2UXBDjEs5wp7"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-frost-dark dark:hover:text-gray-100 transition-colors hover:underline underline-offset-2 decoration-1"
          >
            JKBSN ApS<br />
            Havnegade 2B, 1. sal<br/>
            8000 Aarhus C<br>
          </a>
        </address>
        <OfficeStatus />
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xl font-light mb-4 text-frost-dark dark:text-gray-100">Genveje</h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-frost-accent dark:text-gray-300 hover:text-frost-dark dark:hover:text-gray-100 transition-colors hover:underline underline-offset-2 decoration-1">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xl font-light mb-4 text-frost-dark dark:text-gray-100">Kom i kontakt</h3>
        <ul class="space-y-3 text-frost-accent dark:text-gray-300">
          <li>
            <a href="mailto:mathias@mathiasjakobsen.dk" class="hover:text-frost-dark dark:hover:text-gray-100 transition-colors hover:underline underline-offset-2 decoration-1">
              mathias@mathiasjakobsen.dk
            </a>
          </li>
          <li>
            <a href="tel:+4593967688" class="hover:text-frost-dark dark:hover:text-gray-100 transition-colors hover:underline underline-offset-2 decoration-1">
              +45 93 96 76 88
            </a>
          </li>
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-frost-dark dark:hover:text-gray-100 transition-colors inline-flex items-baseline gap-1 hover:underline underline-offset-2 decoration-1"
                aria-label={link.ariaLabel}
              >
                <span>{link.label}</span>
                <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"></path>
                </svg>
              </a>
            </li>
          ))}
          <li class="pt-4">
            <a
              href="https://calendar.app.google/sjJBuMZGrPCXMLYH7"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-6 py-3 bg-frost-dark dark:bg-gray-800 text-white rounded-frost hover:bg-frost-accent dark:hover:bg-gray-700 transition-all duration-250 hover:scale-105"
            >
              Gratis sparring
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-200 dark:border-gray-700 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-gray-500 dark:text-gray-400 text-sm">
          © {currentYear} JKBSN ApS (CVR: DK45522717)
        </p>
        <div class="flex gap-6">
          {legalLinks.map((link) => (
            <a href={link.href} class="text-gray-500 dark:text-gray-400 hover:text-frost-dark dark:hover:text-gray-100 transition-colors text-sm hover:underline underline-offset-2 decoration-1">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
