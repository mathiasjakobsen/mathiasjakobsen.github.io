---
import OfficeStatus from './OfficeStatus.astro';
---

<section class="pt-32 md:pt-64 pb-16 md:pb-24">
  <div class="px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24 mr-4 sm:mr-12 lg:mr-24">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12 md:gap-16">
      <!-- Text content -->
      <div class="flex-1 space-y-12">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-light text-frost-dark dark:text-gray-100 leading-tight">
          Brug for tech kompetencer,<br /> der forstår din forretning?
        </h1>
        <p class="text-lg md:text-xl text-frost-accent dark:text-gray-300 leading-relaxed max-w-2xl">
          Rådgivning, ekstern ledelse & hands-on produkt- og softwareudvikling til små og mellemstore virksomheder.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href="#contact"
            class="inline-block px-8 py-3 border-2 border-frost-dark dark:border-gray-600 text-frost-dark dark:text-gray-100 rounded-frost hover:bg-frost-dark dark:hover:bg-gray-800 hover:text-white transition-all duration-250"
          >
            mathias@mathiasjakobsen.dk
          </a>
          <a
            href="tel:+4593967688"
            class="inline-block px-8 py-3 border-2 border-transparent text-frost-dark dark:text-gray-100 rounded-frost hover:bg-frost-dark dark:hover:bg-gray-800 hover:text-white transition-all duration-250"
          >
            +45 93 96 76 88
          </a>
        </div>

        <OfficeStatus />
      </div>

      <!-- Image -->
      <div class="w-full md:w-auto md:flex-shrink-0">
        <div class="w-full md:w-64 lg:w-80 overflow-hidden border rounded-md">
          <img src="./hello.jpg" alt="Mathias Lynnerup Jakobsen" class="w-full" />
        </div>
      </div>
    </div>
  </div>
</section>
