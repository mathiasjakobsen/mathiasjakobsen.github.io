---
import OfficeStatus from './OfficeStatus.astro';
---

<section class="pt-32 md:pt-64 pb-16 md:pb-24">
  <div class="px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24 mr-4 sm:mr-12 lg:mr-24">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12 md:gap-16">
      <!-- Text content -->
      <div class="flex-1 space-y-12">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-light text-frost-dark dark:text-gray-100 leading-tight">
          Brug for tech kompetencer,<br /> der forstår din forretning?
        </h1>
        <p class="text-lg md:text-xl text-frost-accent dark:text-gray-300 leading-relaxed max-w-2xl">
          Rådgivning, ekstern ledelse & hands-on produkt- og softwareudvikling til små og mellemstore virksomheder.
        </p>


        <div class="flex items-center gap-2 text-sm text-frost-accent dark:text-gray-400">
          <OfficeStatus />
          <span>⋅</span>
          <a href="tel:+4593967688" class="hover:text-frost-dark dark:hover:text-gray-100 transition-colors text-sm hover:underline underline-offset-2 decoration-1">
            +45 93 96 77 88
          </a>
          <span>⋅</span>
          <a href="mailto:mathias@mathiasjakobsen.dk" class="hover:text-frost-dark dark:hover:text-gray-100 transition-colors text-sm hover:underline underline-offset-2 decoration-1">
            mathias@mathiasjakobsen.dk
          </a>
        </div>
      </div>

    </div>

      <!-- Image -->
      <div class="w-full md:w-auto md:flex-shrink-0 mt-16">
        <div class="w-full md:w-2/3 lg:w-2/3 overflow-hidden border-0 rounded-md">
          <img src="./hello.jpg" alt="Mathias Lynnerup Jakobsen" />
        </div>
      </div>
  </div>
</section>
