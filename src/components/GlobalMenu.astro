---
const menuItems = [
  { href: '/', label: 'Hjem', size: 'large' },
  { href: '/om', label: 'Om', size: 'large' },
  { href: '/cases', label: 'Cases', size: 'large' },
  { href: '/udtalelser', label: 'Udtalelser', size: 'large' },
  { href: '/kontakt', label: 'Kontakt', size: 'large' },
];

const roleItems = [
  { href: '/raadgiver', label: 'Rådgiver', size: 'medium' },
  { href: '/fractional-cto', label: 'Fractional CTO', size: 'medium' },
  { href: '/softwareudvikler', label: 'Softwareudvikler', size: 'medium' },
];

const getSizeClass = (size: string) => {
  return size === 'large' ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl';
};
---

<!-- Global Menu Overlay -->
<div
  id="global-menu-overlay"
  class="fixed inset-0 bg-black/20 dark:bg-black/40 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 z-40"
>
</div>

<!-- Global Menu Panel -->
<div
  id="global-menu-panel"
  class="fixed right-0 top-0 bottom-0 w-full sm:w-2/5 bg-white dark:bg-gray-900 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-50 overflow-y-auto"
>
  <div class="flex flex-col h-full">
    <!-- Close Button -->
    <div class="flex justify-end p-6 border-b border-gray-100 dark:border-gray-800">
      <button
        id="global-menu-close"
        class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        aria-label="Close menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Menu Content -->
    <nav class="flex-1 px-8 py-12" aria-label="Hovednavigation">
      <ul class="space-y-6">
        {menuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`${getSizeClass(item.size)} font-light text-frost-dark dark:text-gray-100 hover:text-frost-accent dark:hover:text-gray-300 transition-colors block global-menu-link hover:underline underline-offset-4 decoration-1`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>



      <ul class="mt-24 space-y-6">
        <li class="text-md">Hyr mig som</li>
        {roleItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`${getSizeClass(item.size)} font-light text-frost-dark dark:text-gray-100 hover:text-frost-accent dark:hover:text-gray-300 transition-colors block global-menu-link hover:underline underline-offset-4 decoration-1`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>


      <!-- CTA Button -->
      <div class="mt-12">
        <a
          href="https://calendar.app.google/sjJBuMZGrPCXMLYH7"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-4 bg-frost-dark dark:bg-gray-800 text-white rounded-frost hover:bg-frost-accent dark:hover:bg-gray-700 transition-all duration-250 hover:scale-105 hover:shadow-lg global-menu-link"
        >
          Gratis sparring
        </a>
      </div>
    </nav>

    <!-- Footer Info -->
    <div class="px-8 py-8 border-t border-gray-100 dark:border-gray-800 bg-frost-light dark:bg-gray-950">
      <div class="space-y-3">
        <p class="text-sm text-frost-accent dark:text-gray-400">
          <a href="mailto:mathias@mathiasjakobsen.dk" class="hover:text-frost-dark dark:hover:text-gray-200 transition-colors hover:underline underline-offset-2 decoration-1">
            mathias@mathiasjakobsen.dk
          </a>
        </p>
        <p class="text-sm text-frost-accent dark:text-gray-400">
          <a href="https://github.com/mathiasjakobsen" target="_blank" rel="noopener noreferrer" class="hover:text-frost-dark dark:hover:text-gray-200 transition-colors inline-flex items-baseline gap-1 hover:underline underline-offset-2 decoration-1" aria-label="GitHub (åbner i nyt vindue)">
            <span>GitHub</span>
            <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  const menuOverlay = document.getElementById('global-menu-overlay');
  const menuPanel = document.getElementById('global-menu-panel');
  const closeButton = document.getElementById('global-menu-close');
  const menuLinks = document.querySelectorAll('.global-menu-link');

  function openMenu() {
    menuOverlay?.classList.remove('pointer-events-none', 'opacity-0');
    menuPanel?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
    // Notify that menu is open
    document.dispatchEvent(new CustomEvent('globalMenuOpened'));
  }

  function closeMenu() {
    menuOverlay?.classList.add('pointer-events-none', 'opacity-0');
    menuPanel?.classList.add('translate-x-full');
    document.body.style.overflow = '';
    // Notify that menu is closed
    document.dispatchEvent(new CustomEvent('globalMenuClosed'));
  }

  closeButton?.addEventListener('click', closeMenu);
  menuOverlay?.addEventListener('click', closeMenu);

  menuLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
    }
  });

  // Listen for global menu open/close events
  document.addEventListener('openGlobalMenu', openMenu);
  document.addEventListener('closeGlobalMenu', closeMenu);
</script>
