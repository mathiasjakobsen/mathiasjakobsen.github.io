---
import DarkModeToggle from './DarkModeToggle.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-frost">
  <div class="px-4 sm:px-6 lg:px-8 ml-4 sm:ml-12 lg:ml-24 mr-4 sm:mr-12 lg:mr-24">
    <div class="flex justify-between items-center h-16 md:h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="text-xl md:text-2xl font-light text-frost-dark dark:text-gray-100 hover:text-frost-accent dark:hover:text-gray-300 transition-colors hover:underline underline-offset-4 decoration-1">
          Mathias Lynnerup Jakobsen <span class="text-gray-400 dark:text-gray-500">⋅ <span id="typewriter-text"></span><span id="typewriter-cursor" class="inline-block w-0.5 h-5 bg-current ml-0.5 animate-pulse"></span></span>
        </a>
      </div>

      <!-- Right side buttons -->
      <div class="flex items-center gap-2">
        <DarkModeToggle />

        <!-- Hamburger/Close Menu Button -->
        <button
          id="global-menu-button"
          class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors relative z-50"
          aria-label="Toggle menu"
        >
        <!-- Hamburger Icon -->
        <svg id="hamburger-icon" class="w-6 h-6 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <!-- Close Icon -->
        <svg id="close-icon" class="w-6 h-6 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('global-menu-button');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  let isMenuOpen = false;

  function updateIcon(open: boolean) {
    isMenuOpen = open;
    if (open) {
      // Show close icon
      hamburgerIcon?.classList.add('opacity-0', 'rotate-90');
      closeIcon?.classList.remove('opacity-0');
      closeIcon?.classList.add('rotate-0');
    } else {
      // Show hamburger icon
      hamburgerIcon?.classList.remove('opacity-0', 'rotate-90');
      closeIcon?.classList.add('opacity-0');
      closeIcon?.classList.remove('rotate-0');
    }
  }

  menuButton?.addEventListener('click', () => {
    if (isMenuOpen) {
      document.dispatchEvent(new CustomEvent('closeGlobalMenu'));
    } else {
      document.dispatchEvent(new CustomEvent('openGlobalMenu'));
    }
  });

  // Listen for menu state changes
  document.addEventListener('globalMenuOpened', () => {
    updateIcon(true);
  });

  document.addEventListener('globalMenuClosed', () => {
    updateIcon(false);
  });

  // Typewriter effect
  const titles = ['Freelance EDB-chef', 'Fractional CTO'];
  let titleIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let isPaused = false;

  const typewriterText = document.getElementById('typewriter-text');

  function typeWriter() {
    if (!typewriterText) return;

    const currentTitle = titles[titleIndex];

    if (isPaused) {
      isPaused = false;
      setTimeout(typeWriter, 2000); // Pause for 2 seconds before deleting
      return;
    }

    if (isDeleting) {
      // Delete character
      typewriterText.textContent = currentTitle.substring(0, charIndex - 1);
      charIndex--;

      if (charIndex === 0) {
        isDeleting = false;
        titleIndex = (titleIndex + 1) % titles.length;
        setTimeout(typeWriter, 500); // Pause before typing next title
        return;
      }
    } else {
      // Type character
      typewriterText.textContent = currentTitle.substring(0, charIndex + 1);
      charIndex++;

      if (charIndex === currentTitle.length) {
        isDeleting = true;
        isPaused = true;
        setTimeout(typeWriter, 100);
        return;
      }
    }

    // Speed varies between typing and deleting
    const speed = isDeleting ? 50 : 100;
    setTimeout(typeWriter, speed);
  }

  // Start typewriter effect
  typeWriter();
</script>
